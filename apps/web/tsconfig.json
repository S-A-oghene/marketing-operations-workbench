{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@mow/core": [
        "../../packages/core/src/index.ts"
      ],
      "@mow/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@mow/recipes": [
        "../../packages/recipes/src/index.ts"
      ],
      "@mow/evaluators": [
        "../../packages/evaluators/src/index.ts"
      ],
      "@mow/ai-gateway": [
        "../../packages/ai-gateway/src/index.ts"
      ],
      "@mow/connectors": [
        "../../packages/connectors/src/index.ts"
      ]
    },
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
