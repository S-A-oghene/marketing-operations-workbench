{"$schema":"node_modules/wrangler/config-schema.json","name":"marketing-operations-workbench","main":"worker/index.ts","compatibility_date":"2026-09-23","workers_dev":true,
"d1_databases":[{"binding":"DB","database_name":"mow-db","database_id":"REPLACE_WITH_D1_DATABASE_ID"}],
"r2_buckets":[{"binding":"ASSETS","bucket_name":"mow-assets"}],
"queues":{"producers":[{"binding":"JOBS","queue":"mow-jobs"}],"consumers":[{"queue":"mow-jobs","max_batch_size":10,"max_batch_timeout":5}]},
"vars":{"DEMO_AUTH":"true","FRONTEND_ORIGIN":"https://REPLACE_WITH_PAGES_ORIGIN"}}
